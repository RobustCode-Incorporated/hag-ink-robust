DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth session signing key (required in production)
AUTH_JWT_SECRET="replace_with_a_long_random_secret"

# Optional explicit credentials for management access.
# If omitted, login falls back to User records in database.
CEO_LOGIN_EMAIL="admin@hagink.local"
CEO_LOGIN_PASSWORD="change_me"
MANAGER_LOGIN_EMAIL="manager@hagink.local"
MANAGER_LOGIN_PASSWORD="change_me"

# Keep public client portal disabled while shipping management only.
NEXT_PUBLIC_MANAGEMENT_ONLY="true"

# Stripe test-mode secret key. Never expose this value to the browser or commit .env.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# FlexPay (Infoset) — paste the token/merchant code exactly as given, no
# surrounding quotes/newlines/spaces. A malformed value here is a common
# cause of opaque base64-decode errors returned by the FlexPay API.
FLEXPAY_TOKEN="replace_with_flexpay_bearer_token"
FLEXPAY_MERCHANT="replace_with_flexpay_merchant_code"
FLEXPAY_MOBILE_URL="https://backend.flexpay.cd/api/rest/v1/paymentService"
FLEXPAY_CARD_URL="https://cardpayment.flexpay.cd/v1.1/pay"
# Not yet consumed by route.ts — kept for a future "check transaction" endpoint.
FLEXPAY_CHECK_URL="https://backend.flexpay.cd/api/rest/v1/check/orderNumber"
