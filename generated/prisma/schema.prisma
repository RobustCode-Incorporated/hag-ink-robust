// Prisma schema for Hag & Ink

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Database configuration is now supplied via prisma.config.ts for Prisma 7.
datasource db {
  provider = "postgresql"
}

enum Role {
  CEO
  MANAGER
  BARBER
  CLEANER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barberProfile Barber?
  clientProfile Client?
  expenses      Expense[]
}

model Barber {
  id             String  @id @default(uuid())
  firstName      String
  lastName       String
  phone          String?
  salaryType     String  @default("COMMISSION")
  fixedSalary    Float   @default(0.0)
  commissionRate Float   @default(0.25)
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  services     Service[]
  appointments Appointment[]
}

model Client {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  phone     String  @unique
  email     String? @unique
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  planId     String?
  plan       Plan?     @relation(fields: [planId], references: [id])
  planEndsAt DateTime?

  appointments   Appointment[]
  services       Service[]
  lotteryTickets LotteryTicket[]
  payments       Payment[]
  createdAt      DateTime        @default(now())
}

model Plan {
  id           String    @id @default(uuid())
  name         String
  price        Float
  durationDays Int       @default(30)
  features     String[]
  clients      Client[]
  payments     Payment[]
}

model Appointment {
  id       String            @id @default(uuid())
  dateTime DateTime
  status   AppointmentStatus @default(PENDING)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(uuid())
  amount    Float
  priceType String   @default("FIXED")
  createdAt DateTime @default(now())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  invoice      Invoice?
  usedProducts ServiceProduct[]
}

model Product {
  id            String  @id @default(uuid())
  name          String
  sku           String  @unique
  purchasePrice Float
  sellingPrice  Float
  stockQty      Int     @default(0)
  isConsumable  Boolean @default(false)

  usedInServices ServiceProduct[]
}

model ServiceProduct {
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@id([serviceId, productId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  pdfUrl        String?
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  isValidated Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LotteryTicket {
  id        String   @id @default(uuid())
  ticketNum String   @unique
  drawDate  DateTime
  isWinner  Boolean  @default(false)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Payment {
  id                 String        @id @default(uuid())
  flexpayOrderNumber String        @unique
  providerReference  String?
  amount             Int
  currency           String
  status             PaymentStatus @default(PAID)
  createdAt          DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
}
